  "query": "\n        SELECT t.id, t.block_id, t.task_type, t.public_payload\n        FROM tasks t\n        JOIN blocks b ON b.id = t.block_id\n        WHERE b.lesson_id = $1 AND t.retired_at IS NULL AND b.retired_at IS NULL\n        ",
