  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.position, l.locale, l.title, l.description\n        FROM topics t\n        JOIN topic_localizations l ON l.topic_id = t.id\n        WHERE t.course_id = $1 AND t.retired_at IS NULL\n        ORDER BY t.position, l.locale\n        ",
