{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.user_id, i.email_verified_at, c.password_hash\n        FROM user_identities i\n        JOIN password_credentials c ON c.identity_id = i.id\n        WHERE i.provider = 'password'\n          AND i.identifier_kind = 'email'\n          AND i.identifier = $1\n        ",
