  "query": "\n        SELECT c.id, c.default_locale, l.locale, l.title, l.description\n        FROM courses c\n        JOIN course_localizations l ON l.course_id = c.id\n        WHERE c.retired_at IS NULL\n        ORDER BY c.id, l.locale\n        ",
