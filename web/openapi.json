{
  "openapi": "3.1.0",
  "info": {
    "title": "Edurust API",
    "description": "Learning platform API.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/auth/csrf": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "csrf",
        "responses": {
          "200": {
            "description": "CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session revoked"
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "409": {
            "description": "Email is already registered"
          }
        }
      }
    },
    "/v1/courses": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "list_courses",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "en",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Visible courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/courses/{course_id}": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "course_detail",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "description": "Course slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "en",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/lessons/{lesson_id}": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "lesson",
        "parameters": [
          {
            "name": "lesson_id",
            "in": "path",
            "description": "Lesson slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "en",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public lesson",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/progress": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "progress",
        "parameters": [
          {
            "name": "course_id",
            "in": "query",
            "description": "Optional course filter",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lesson progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}/attempts": {
      "post": {
        "tags": [
          "learning"
        ],
        "operationId": "submit_attempt",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "description": "Task slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Graded attempt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttemptRequest": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "choice_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "choice_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string"
          }
        }
      },
      "AttemptResponse": {
        "type": "object",
        "required": [
          "attempt_id",
          "task_id",
          "correct",
          "feedback",
          "locale_used",
          "submitted_answer",
          "created_at"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct": {
            "type": "boolean"
          },
          "correct_choice_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string"
          },
          "feedback": {
            "type": "string"
          },
          "locale_used": {
            "type": "string"
          },
          "submitted_answer": {},
          "task_id": {
            "type": "string"
          }
        }
      },
      "BlockView": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "markdown",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "markdown": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "url",
              "title",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video"
                ]
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "task",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "task"
                ]
              },
              "task": {
                "$ref": "#/components/schemas/TaskView"
              }
            }
          }
        ]
      },
      "ChoiceView": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "CourseDetail": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "locale_used",
          "topics"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "locale_used": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicNode"
            }
          }
        }
      },
      "CourseListResponse": {
        "type": "object",
        "required": [
          "courses"
        ],
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
            }
          }
        }
      },
      "CourseSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "locale_used"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "locale_used": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "LessonLink": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "LessonProgressBody": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      },
      "LessonProgressItem": {
        "type": "object",
        "required": [
          "lesson_id",
          "status"
        ],
        "properties": {
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "lesson_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "LessonResponse": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "locale_used",
          "course_id",
          "topic_id",
          "subtopic_id",
          "progress",
          "blocks"
        ],
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockView"
            }
          },
          "course_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "locale_used": {
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/LessonProgressBody"
          },
          "subtopic_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topic_id": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProgressResponse": {
        "type": "object",
        "required": [
          "lessons"
        ],
        "properties": {
          "lessons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LessonProgressItem"
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SubtopicNode": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "lessons"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lessons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LessonLink"
            }
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TaskView": {
        "type": "object",
        "required": [
          "id",
          "type",
          "prompt"
        ],
        "properties": {
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChoiceView"
            }
          },
          "id": {
            "type": "string"
          },
          "latest_attempt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttemptResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "TopicNode": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "subtopics"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "subtopics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubtopicNode"
            }
          },
          "title": {
            "type": "string"
          }
        }
      },
      "UserBody": {
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserBody"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Registration and sessions"
    },
    {
      "name": "learning",
      "description": "Courses, lessons, and attempts"
    }
  ]
}