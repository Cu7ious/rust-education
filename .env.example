# Copy to .env at the repository root. Do not commit .env.

DATABASE_URL=postgres://edurust:edurust@localhost:5432/edurust
TEST_DATABASE_URL=postgres://edurust:edurust@localhost:5432/edurust_test

APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_BIND=127.0.0.1:3001
COOKIE_SECURE=false

# Must stay false when APP_ENV=production. Local delivery logs codes in a later milestone.
DEV_LOG_VERIFICATION_CODES=false

# Reserved for later milestones. Leave unset until those providers are configured.
# SMTP_URL=
# SMS_PROVIDER=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Next.js rewrite target. The browser calls the web origin, which proxies /api/v1.
API_ORIGIN=http://127.0.0.1:3001
